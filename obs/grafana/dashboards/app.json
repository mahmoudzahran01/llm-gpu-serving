{
 "uid": "app",
 "title": "App (RED) - LLM-backed demo service",
 "description": "RED method for the FastAPI demo service: Rate, Errors, Duration, plus stage latency, tokens and cost.",
 "tags": [
  "app",
  "red",
  "slo",
  "genai"
 ],
 "schemaVersion": 41,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "timezone": "browser",
 "templating": {
  "list": []
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Alerts firing",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\",alertname=~\"App.*\"}",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{summary}}",
    "step": "15s"
   },
   {
    "name": "Fault windows",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "orange",
    "target": {
     "type": "tags",
     "tags": [
      "fault"
     ],
     "limit": 100,
     "matchAny": false
    }
   }
  ]
 },
 "links": [
  {
   "title": "LLM serving",
   "type": "link",
   "url": "/d/llm-serving",
   "icon": "dashboard"
  },
  {
   "title": "App",
   "type": "link",
   "url": "/d/app",
   "icon": "dashboard"
  },
  {
   "title": "Infra",
   "type": "link",
   "url": "/d/infra",
   "icon": "dashboard"
  }
 ],
 "panels": [
  {
   "type": "text",
   "title": "",
   "options": {
    "mode": "markdown",
    "content": "**RED** = *Rate* (requests/s), *Errors* (5xx share - the SLI), *Duration* (latency). The SLO is **99% of /ask requests succeed** (error budget 1%). *Burn rate* = error ratio / 0.01: 1 means spending the budget exactly on schedule, 14.4 means it is gone in 2 days. The small dots on the latency graph are **exemplars**: click one to open the trace of a request that landed in that latency bucket. Bottom row: traces and logs from the same requests, joined by `trace_id`."
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 4
   }
  },
  {
   "id": 2,
   "type": "row",
   "title": "Golden signals (RED) - right now",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Request rate",
   "description": "RED-Rate.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(llmapp_http_requests_total{route=\"/ask\"}[1m]))",
     "legendFormat": "",
     "instant": false,
     "range": true,
     "exemplar": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "id": 3,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Error ratio (5m)",
   "description": "RED-Errors / the SLI. Yellow = above the 1% budget rate, red = fast-burn threshold (14.4x).",
