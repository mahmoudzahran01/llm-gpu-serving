    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "app:ask_error_ratio:rate5m",
     "legendFormat": "",
     "instant": false,
     "range": true,
     "exemplar": false
