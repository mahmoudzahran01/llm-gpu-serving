{
 "uid": "infra",
 "title": "Infra - host, GPU, pipeline",
 "description": "USE method (Utilization, Saturation, Errors) for the host, the GPU and the observability pipeline itself.",
 "tags": [
  "infra",
  "use",
  "gpu"
 ],
 "schemaVersion": 41,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "timezone": "browser",
 "templating": {
  "list": []
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Alerts firing",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\",alertname=~\"TargetDown|HostMemoryLow|GPU.*|OTel.*\"}",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{summary}}",
    "step": "15s"
   },
   {
    "name": "Fault windows",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "orange",
    "target": {
     "type": "tags",
     "tags": [
      "fault"
     ],
     "limit": 100,
     "matchAny": false
    }
   }
  ]
 },
 "links": [
  {
   "title": "LLM serving",
   "type": "link",
   "url": "/d/llm-serving",
   "icon": "dashboard"
  },
  {
   "title": "App",
   "type": "link",
   "url": "/d/app",
   "icon": "dashboard"
  },
  {
   "title": "Infra",
   "type": "link",
   "url": "/d/infra",
   "icon": "dashboard"
  }
 ],
 "panels": [
  {
   "type": "text",
   "title": "",
   "options": {
    "mode": "markdown",
    "content": "**USE** per resource: *Utilization* (how busy), *Saturation* (work queued/waiting), *Errors*. GB10 note: CPU and GPU share one **unified memory** pool, so 'GPU memory' = system memory pressure; per-process GPU memory comes from the small nvidia-smi exporter (DCGM reports no framebuffer / per-process memory on GB10). The bottom row monitors the monitoring (collector, Prometheus)."
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 4
   }
  },
  {
   "id": 2,
   "type": "row",
   "title": "Scrape health",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Scrape targets",
   "description": "Every Prometheus target. vllm-extra is expected to be DOWN when its server is stopped (optional=true, exempt from TargetDown).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "exemplar": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "state"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "DOWN",
            "color": "red",
            "index": 0
           },
           "1": {
            "text": "UP",
            "color": "green",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "state",
      "desc": false
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "engine": true,
       "optional": true,
       "namespace": true,
       "cluster": true
      },
      "renameByName": {
       "Value": "state"
      },
      "indexByName": {
       "job": 0,
       "instance": 1,
       "state": 2
      }
     }
    }
   ],
   "id": 3,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 9
   }
  },
  {
