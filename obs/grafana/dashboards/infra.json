  {
   "type": "timeseries",
   "title": "CPU utilization (USE-U) and load per core (USE-S)",
   "description": "Utilization = share of non-idle time. Load per core > 1 means runnable threads are waiting = saturation.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))",
     "legendFormat": "CPU busy",
     "instant": false,
     "range": true,
     "exemplar": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_load1 / count(count by (cpu) (node_cpu_seconds_total))",
     "legendFormat": "load1 per core (saturation)",
     "instant": false,
     "range": true,
     "exemplar": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
