  {
   "type": "timeseries",
   "title": "Inter-token latency (TPOT)",
   "description": "Gap between streamed tokens = how fast the answer 'types'. Decode is memory-bandwidth bound, so it degrades with batch size and when the GPU is shared. 1/TPOT = tokens/s per user.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
     "legendFormat": "inter-token p50",
     "instant": false,
     "range": true,
     "exemplar": false
    },
    {
