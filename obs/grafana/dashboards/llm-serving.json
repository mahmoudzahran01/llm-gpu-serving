{
 "uid": "llm-serving",
 "title": "LLM serving (vLLM)",
 "description": "Golden signals and saturation of the model servers. RED = request-centric (Rate, Errors, Duration); USE = resource-centric (Utilization, Saturation, Errors).",
 "tags": [
  "llm",
  "vllm",
  "red",
  "use"
 ],
 "schemaVersion": 41,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "instance",
    "label": "vLLM instance",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(vllm:num_requests_running, instance)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": false,
    "multi": false,
    "current": {
     "text": "obs-vllm",
     "value": "obs-vllm"
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Alerts firing",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\",alertname=~\"LLM.*\"}",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{summary}}",
    "step": "15s"
   },
   {
    "name": "Fault windows",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "orange",
    "target": {
     "type": "tags",
     "tags": [
      "fault"
     ],
     "limit": 100,
     "matchAny": false
    }
   }
  ]
 },
 "links": [
  {
   "title": "LLM serving",
   "type": "link",
   "url": "/d/llm-serving",
   "icon": "dashboard"
  },
  {
   "title": "App",
   "type": "link",
   "url": "/d/app",
   "icon": "dashboard"
  },
  {
   "title": "Infra",
   "type": "link",
   "url": "/d/infra",
   "icon": "dashboard"
  }
 ],
 "panels": [
  {
   "type": "text",
   "title": "",
   "options": {
    "mode": "markdown",
    "content": "**How to read this board.** *Top row = is it OK right now?* Then **RED** rows describe the experience of requests (how many, how many fail, how long) and the **USE** row describes the resource (KV cache = the scarce resource, queue = saturation). Latency is split the way LLM users feel it: **TTFT** (wait before the first token) vs **inter-token latency / TPOT** (speed of the stream) vs **E2E**. Select the engine with the `instance` variable (obs-vllm = the container started by run_obs_vllm.sh, vllm-extra = an optional second server when up)."
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 4
   }
  },
  {
   "id": 2,
   "type": "row",
   "title": "Now (stat row)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Running requests",
   "description": "USE: requests currently in the engine batch.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(vllm:num_requests_running{instance=~\"$instance\"})",
     "legendFormat": "",
     "instant": false,
     "range": true,
     "exemplar": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "id": 3,
