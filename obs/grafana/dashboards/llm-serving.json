  {
   "type": "gauge",
   "title": "KV cache usage",
   "description": "USE-Utilization of THE scarce resource. At 100% requests queue or are preempted. Alert at 90%.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(vllm:kv_cache_usage_perc{instance=~\"$instance\"})",
     "legendFormat": "",
     "instant": false,
     "range": true,
     "exemplar": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
