     "expr": "sum (rate(vllm:request_prefill_time_seconds_sum{instance=~\"$instance\"}[$__rate_interval])) / sum (rate(vllm:request_prefill_time_seconds_count{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "prefill",
     "instant": false,
     "range": true,
     "exemplar": false
