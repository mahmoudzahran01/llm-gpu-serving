  {
   "type": "timeseries",
   "title": "Where does a request spend its time? (mean, stacked)",
   "description": "Queue = waiting for a free slot / KV blocks (saturation). Prefill = prompt processing (compute-bound, scales with prompt length). Decode = generation (bandwidth-bound, scales with output length).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum (rate(vllm:request_queue_time_seconds_sum{instance=~\"$instance\"}[$__rate_interval])) / sum (rate(vllm:request_queue_time_seconds_count{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "queue",
     "instant": false,
     "range": true,
     "exemplar": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
