  {
   "type": "timeseries",
   "title": "Time to first token (TTFT)",
   "description": "Queue wait + prefill (processing the prompt) + first decode step. Grows with queue depth and prompt length. Percentiles are estimated from histogram buckets (linear interpolation inside a bucket) - approximate, see README.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "instant": false,
     "range": true,
     "exemplar": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "instant": false,
     "range": true,
     "exemplar": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
     "legendFormat": "p99",
     "instant": false,
     "range": true,
     "exemplar": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
